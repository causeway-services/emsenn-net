{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module structure",
  "type": "object",
  "required": ["module_root", "required_files", "required_dirs"],
  "properties": {
    "module_root": { "type": "string" },
    "required_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_dirs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
