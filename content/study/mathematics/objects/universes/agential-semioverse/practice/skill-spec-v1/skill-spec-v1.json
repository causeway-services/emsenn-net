{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-spec-v1",
  "title": "Skill Specification v1",
  "description": "Schema for SKILL.md frontmatter defining executable skills with typed inputs/outputs",
  "type": "object",
  "required": ["skill_spec_version", "id", "name", "kind", "authors", "date-created"],
  "properties": {
    "skill_spec_version": {
      "type": "string",
      "const": "1",
      "description": "Version of the skill specification"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier for the skill (kebab-case)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the skill"
    },
    "summary": {
      "type": "string",
      "description": "Brief one-line description of what the skill does"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the skill"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "0.1.0",
      "description": "Semantic version of the skill"
    },
    "kind": {
      "type": "string",
      "enum": ["skill", "agent-skill"],
      "description": "Type of skill"
    },
    "skill_kind": {
      "type": "string",
      "enum": ["human", "automation", "service"],
      "description": "Execution context - human (manual), automation (script), or service (API)"
    },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "List of author identifiers"
    },
    "date-created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "date-updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last update date in YYYY-MM-DD format"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Categorization tags"
    },
    "runtime": {
      "type": "object",
      "description": "Execution configuration for automation skills",
      "properties": {
        "entrypoint": {
          "type": "string",
          "description": "Path to the script relative to skill directory"
        },
        "language": {
          "type": "string",
          "enum": ["python", "bash", "node"],
          "description": "Runtime language"
        },
        "invocation": {
          "type": "string",
          "enum": ["cli", "module", "function"],
          "default": "cli",
          "description": "How to invoke the script"
        },
        "env_vars": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required environment variables"
        }
      },
      "required": ["entrypoint", "language"]
    },
    "inputs": {
      "type": "array",
      "description": "Input parameters for the skill",
      "items": {
        "$ref": "#/definitions/parameter"
      }
    },
    "outputs": {
      "type": "array",
      "description": "Output values produced by the skill",
      "items": {
        "$ref": "#/definitions/parameter"
      }
    },
    "capabilities": {
      "type": "object",
      "description": "What this skill can do and integrate with",
      "properties": {
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Functional domains (e.g., publishing, writing, programming)"
        },
        "consumes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Resource types this skill reads"
        },
        "provides": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Resource types this skill produces"
        },
        "composable": {
          "type": "boolean",
          "default": true,
          "description": "Whether this skill can be chained with others"
        }
      }
    },
    "examples": {
      "type": "array",
      "description": "Usage examples",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "inputs": { "type": "object" },
          "expected_output": { "type": "object" }
        }
      }
    }
  },
  "definitions": {
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "Parameter name (snake_case)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "array", "object", "path"],
          "description": "Data type"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether this parameter is required"
        },
        "default": {
          "description": "Default value if not provided"
        },
        "enum": {
          "type": "array",
          "description": "Allowed values"
        },
        "format": {
          "type": "string",
          "description": "Format hint (e.g., date, uri, file-path)"
        },
        "schema_ref": {
          "type": "string",
          "description": "Reference to a shared schema in library/specs/skill-types/"
        },
        "items": {
          "type": "object",
          "description": "Schema for array items"
        }
      }
    }
  },
  "additionalProperties": true
}
