{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository Markdown Frontmatter",
  "type": "object",
  "required": ["id", "kind", "authors", "date-created"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "date-created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date-updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "concept": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "type": "string" },
    "version": { "type": "string" },
    "references": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "publications": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      }
    }
  },
  "anyOf": [
    { "required": ["title"] },
    { "required": ["name"] }
  ],
  "additionalProperties": true
}
